{
  "dataRoles": [
    { "name": "source", "displayName": "Source Activity ID", "displayNameKey": "roleSource", "kind": "Grouping", "requiredTypes": [{ "text": true }] },
    { "name": "target", "displayName": "Target Activity ID", "displayNameKey": "roleTarget", "kind": "Grouping", "requiredTypes": [{ "text": true }] },
    { "name": "frequency", "displayName": "Transition Frequency", "displayNameKey": "roleFrequency", "kind": "Measure", "requiredTypes": [{ "numeric": true }] },
    { "name": "duration", "displayName": "Prepared Duration Statistic", "displayNameKey": "roleDuration", "kind": "Measure", "requiredTypes": [{ "numeric": true }] },
    { "name": "variant", "displayName": "Variant", "displayNameKey": "roleVariant", "kind": "Grouping", "requiredTypes": [{ "text": true }] },
    { "name": "rowKey", "displayName": "Prepared Row ID (optional grain)", "displayNameKey": "roleRowKey", "kind": "Grouping" },
    { "name": "tooltip", "displayName": "Tooltips", "displayNameKey": "roleTooltip", "kind": "GroupingOrMeasure" }
  ],
  "dataViewMappings": [{
    "conditions": [{
      "source": { "min": 1, "max": 1 },
      "target": { "min": 1, "max": 1 },
      "frequency": { "min": 1, "max": 1 },
      "duration": { "max": 1 },
      "variant": { "max": 1 },
      "rowKey": { "max": 1 },
      "tooltip": { "max": 6 }
    }],
    "table": {
      "rows": {
        "select": [
          { "for": { "in": "source" } },
          { "for": { "in": "target" } },
          { "for": { "in": "frequency" } },
          { "for": { "in": "duration" } },
          { "for": { "in": "variant" } },
          { "for": { "in": "rowKey" } },
          { "for": { "in": "tooltip" } }
        ],
        "dataReductionAlgorithm": { "window": { "count": 2000 } }
      }
    }
  }],
  "objects": {
    "appearance": {
      "displayName": "Graph",
      "properties": {
        "edgeColor": { "displayName": "Transition color", "type": { "fill": { "solid": { "color": true } } } },
        "nodeColor": { "displayName": "Activity color", "type": { "fill": { "solid": { "color": true } } } },
        "showLabels": { "displayName": "Show edge metrics", "type": { "bool": true } }
      }
    },
    "navigation": {
      "displayName": "Local view state",
      "properties": { "state": { "displayName": "Bookmark state", "type": { "text": true } } }
    },
    "metrics": {
      "displayName": "Duration provenance",
      "properties": {
        "statistic": { "displayName": "Supplied statistic (e.g. mean, p95)", "type": { "text": true } },
        "unit": { "displayName": "Supplied unit (e.g. hours)", "type": { "text": true } },
        "provenance": { "displayName": "Preparation / metric definition", "type": { "text": true } }
      }
    }
  },
  "privileges": [],
  "supportsHighlight": false,
  "supportsKeyboardFocus": true,
  "supportsEmptyDataView": true,
  "supportsLandingPage": true,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true,
  "tooltips": { "supportedTypes": { "default": true }, "roles": ["tooltip"] },
  "sorting": { "default": {} }
}
